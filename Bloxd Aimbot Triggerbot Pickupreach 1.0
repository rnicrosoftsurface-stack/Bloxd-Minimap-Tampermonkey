// ==UserScript==
// @name         Bloxd Aim Bot, Trigger Bot und Pickup Reach
// @namespace    bloxd-minimap-safe
// @version      1.8.0
// @description  Bewährter Aim Bot mit Trigger Bot und Pickup Reach.
// @match        https://bloxd.io/*
// @match        https://bloxd.dev/*
// @grant        unsafeWindow
// @run-at       document-start
// ==/UserScript==
(function () {
    "use strict";
    const W = typeof unsafeWindow !== "undefined" ? unsafeWindow : window;
    const address = new URL(W.location.href);
    if (address.searchParams.get("client") !== "js") {
        address.searchParams.set("client", "js");
        W.location.replace(address.href);
        return;
    }
    const FRAME_MS = 33;
    const PLAYERS_MS = 300;
    const TARGET_MS = 150;
    const KEY_STORAGE = "bloxd-aim-bot-key-v1";
    const EXTRA_KEY_STORAGE = "bloxd-extra-bot-keys-v2";
    const TRIGGER_MS = 200;
    const PICKUP_FACTOR = 5;
    const EDGES = [
        [0, 1], [1, 3], [3, 2], [2, 0],
        [4, 5], [5, 7], [7, 6], [6, 4],
        [0, 4], [1, 5], [2, 6], [3, 7]
    ];
    let noa = null;
    let overlay = null;
    let ctx = null;
    let menu = null;
    let toggle = null;
    let keyButton = null;
    let clearKeyButton = null;
    let status = null;
    let enabled = false;
    let waitingForKey = false;
    let selectedKey = readSavedKey();
    let lastFrame = 0;
    let lastPlayers = 0;
    let playerIds = [];
    let nearestId = null;
    let lastTarget = 0;
    let hookedCamera = null;
    let hookedCameraMethod = null;
    let lastAim = 0;
    let boxesDrawn = 0;
    let triggerEnabled = false;
    let pickupEnabled = false;
    let triggerKey = null;
    let pickupHotkey = null;
    let waitingExtra = null;
    let triggerToggle = null;
    let pickupToggle = null;
    let triggerKeyButton = null;
    let pickupKeyButton = null;
    let triggerClearButton = null;
    let pickupClearButton = null;
    let lastTrigger = 0;
    let lastTriggerHit = 0;
    let pickupPatch = null;
    let lastPickupSearch = 0;
    let lastEngineCheck = 0;
    let lastAimReason = "";
    let radarPositions = new Map();
    try {
        const saved = JSON.parse(W.localStorage.getItem(EXTRA_KEY_STORAGE) || "{}");
        if (typeof saved.trigger?.code === "string") triggerKey = saved.trigger;
        if (typeof saved.pickup?.code === "string") pickupHotkey = saved.pickup;
    } catch (_) {}
    function readSavedKey() {
        try {
            const value = JSON.parse(W.localStorage.getItem(KEY_STORAGE));
            if (typeof value?.code === "string" && typeof value?.label === "string") {
                return value;
            }
        } catch (_) {}
        return null;
    }
    function saveKey() {
        try {
            if (selectedKey) {
                W.localStorage.setItem(KEY_STORAGE, JSON.stringify(selectedKey));
            } else {
                W.localStorage.removeItem(KEY_STORAGE);
            }
        } catch (_) {}
    }
    function updateKeyButton() {
        if (!keyButton || !clearKeyButton) return;
        keyButton.textContent = waitingForKey
            ? "…"
            : selectedKey
                ? selectedKey.label === "LEER" ? "␣" : selectedKey.label
                : "–";
        keyButton.style.borderColor = waitingForKey ? "#ffd166" : "#47596b";
        clearKeyButton.disabled = !selectedKey;
        clearKeyButton.style.opacity = selectedKey ? "1" : ".35";
    }
    function isTyping(event) {
        const target = event.target;
        return !!target?.closest?.(
            'input,textarea,select,[contenteditable="true"],[role="textbox"]'
        );
    }
    function isNoa(value) {
        try {
            return !!value &&
                typeof value.entities?.getState === "function" &&
                typeof value.bloxd?.getPlayerIds === "function";
        } catch (_) {
            return false;
        }
    }
    function findNoa() {
        try {
            if (isNoa(W.__bloxdNoa)) return W.__bloxdNoa;
            if (isNoa(W.noa)) return W.noa;
        } catch (_) {}
        return null;
    }
    function captureNoa() {
        noa = findNoa();
        if (noa) {
            hookCamera();
            return;
        }
        const proto = W.Function.prototype;
        const original = proto.call;
        function wrappedCall() {
            if (!noa) {
                try {
                    const argument = arguments[1];
                    const candidate = isNoa(argument)
                        ? argument
                        : argument && typeof argument === "object"
                            ? argument.ap
                            : null;
                    if (isNoa(candidate)) {
                        noa = candidate;
                        hookCamera();
                        if (proto.call === wrappedCall) proto.call = original;
                    }
                } catch (_) {}
            }
            return Reflect.apply(original, this, arguments);
        }
        proto.call = wrappedCall;
        W.setTimeout(() => {
            if (proto.call === wrappedCall) proto.call = original;
        }, 120000);
    }
    function readIds(value) {
        if (value instanceof Map) return [...value.values()];
        if (Array.isArray(value)) return value;
        if (value && typeof value === "object") return Object.values(value);
        return [];
    }
    function refreshPlayers(now) {
        if (now - lastPlayers < PLAYERS_MS) return;
        lastPlayers = now;
        if (!noa) {
            noa = findNoa();
            if (noa) hookCamera();
        }
        const ownIds = new Set([
            1,
            Number(noa?.playerEntity?.id ?? noa?.playerEntity ?? NaN)
        ]);
        const ids = new Set();
        if (noa) try {
            for (const raw of readIds(noa.bloxd.getPlayerIds())) {
                const id = Number(raw?.entityId ?? raw?.id ?? raw);
                if (Number.isFinite(id) && !ownIds.has(id)) ids.add(id);
            }
        } catch (_) {}
        radarPositions = new Map();
        try {
            for (const p of W.__BloxdPlayerRadar?.getPlayers?.() || []) {
                const id = Number(p.id);
                const position = vec3(p);
                if (!Number.isFinite(id) || ownIds.has(id) || !position || p.lastKnown) continue;
                radarPositions.set(id, position);
                ids.add(id);
            }
        } catch (_) {}
        playerIds = [...ids];
        if (!ids.has(nearestId)) nearestId = null;
    }
    function hookCamera() {
        const camera = noa?.camera;
        const method = typeof camera?.QbO === "function"
            ? "QbO"
            : typeof camera?.applyInputsToCamera === "function"
                ? "applyInputsToCamera"
                : null;
        if (!method) return;
        if (hookedCamera === camera && camera[method] === hookedCameraMethod) return;
        const original = camera[method];
        function wrappedInputs() {
            const result = Reflect.apply(original, this, arguments);
            if (enabled) aimAtNearest(this, performance.now());
            return result;
        }
        camera[method] = wrappedInputs;
        hookedCamera = camera;
        hookedCameraMethod = wrappedInputs;
    }
    function globalPosition(id) {
        if (radarPositions.has(id)) return radarPositions.get(id);
        try {
            return vec3(noa?.entities?.getState(id, "position")?.position);
        } catch (_) {
            return null;
        }
    }
    function ownPosition() {
        try {
            const radarOwn = vec3(W.__BloxdPlayerRadar?.getOwnPosition?.());
            if (radarOwn) return radarOwn;
        } catch (_) {}
        const id = Number(noa?.playerEntity?.id ?? noa?.playerEntity);
        return (Number.isFinite(id) ? globalPosition(id) : null) || globalPosition(1);
    }
    function aimAtNearest(camera, now) {
        if (!noa || !camera || !enabled) return;
        refreshPlayers(now);
        if (!playerIds.length) {
            lastAimReason = "Keine Spieler-IDs";
            return;
        }
        const self = ownPosition();
        const useGlobal = !!self;
        const eye = useGlobal
            ? [self[0], self[1] + 1.6, self[2]]
            : vec3(camera.AbO?.() || camera._localGetTargetPosition?.());
        if (!eye) {
            lastAimReason = "Eigene Position fehlt";
            return;
        }
        const targetOf = id => {
            if (useGlobal) {
                const p = globalPosition(id);
                return p ? [p[0], p[1] + 1.35, p[2]] : null;
            }
            const box = playerBox(id);
            return box ? [box.x, box.y + box.tall * 0.75, box.z] : null;
        };
        if (nearestId === null || now - lastTarget >= TARGET_MS) {
            let bestId = null;
            let bestDistance = Infinity;
            for (const id of playerIds) {
                const target = targetOf(id);
                if (!target) continue;
                const dx = target[0] - eye[0];
                const dy = target[1] - eye[1];
                const dz = target[2] - eye[2];
                const distance = dx * dx + dy * dy + dz * dz;
                if (distance > 0.01 && distance < bestDistance) {
                    bestDistance = distance;
                    bestId = id;
                }
            }
            nearestId = bestId;
            lastTarget = now;
        }
        const target = nearestId === null ? null : targetOf(nearestId);
        if (!target) {
            nearestId = null;
            lastAimReason = "Andere Positionen fehlen";
            return;
        }
        const dx = target[0] - eye[0];
        const dy = target[1] - eye[1];
        const dz = target[2] - eye[2];
        const horizontal = Math.hypot(dx, dz);
        if (horizontal < 0.001) return;
        const heading = (Math.atan2(dx, dz) + Math.PI * 2) % (Math.PI * 2);
        const pitch = Math.max(-Math.PI / 2 + 0.001,
            Math.min(Math.PI / 2 - 0.001, -Math.atan2(dy, horizontal)));
        camera.heading = heading;
        camera.pitch = pitch;
        if (typeof camera.meO === "function") {
            camera.meO();
        } else {
            const direction = camera._dirVector || camera.getDirection?.();
            if (direction) {
                direction[0] = Math.sin(heading) * Math.cos(pitch);
                direction[1] = -Math.sin(pitch);
                direction[2] = Math.cos(heading) * Math.cos(pitch);
            }
        }
        lastAimReason = "Ziel aktiv";
        lastAim = now;
    }
    function vec3(value) {
        if (!value) return null;
        const x = Number(value[0] ?? value.x);
        const y = Number(value[1] ?? value.y);
        const z = Number(value[2] ?? value.z);
        return [x, y, z].every(Number.isFinite) ? [x, y, z] : null;
    }
    function playerBox(id) {
        let state;
        try {
            state = noa.entities.getState(id, "position");
        } catch (_) {
            return null;
        }
        if (!state) {
            const p = radarPositions.get(id);
            if (!p) return null;
            const origin = vec3(noa.worldOriginOffset) || vec3(noa.jp) || [0, 0, 0];
            return { x: p[0] - origin[0], y: p[1] - origin[1],
                z: p[2] - origin[2], half: 0.4, tall: 1.8 };
        }
        let position =
            vec3(state.fbO) ||
            vec3(state._renderPosition) ||
            vec3(state._localPosition);
        if (!position) {
            const global = vec3(state.position);
            const origin =
                vec3(noa.worldOriginOffset) ||
                vec3(noa.jp) ||
                [0, 0, 0];
            if (global) position = global.map((v, i) => v - origin[i]);
        }
        if (!position) {
            const p = radarPositions.get(id);
            const origin = vec3(noa.worldOriginOffset) || vec3(noa.jp) || [0, 0, 0];
            if (p) position = p.map((v, i) => v - origin[i]);
        }
        if (!position) return null;
        const width = Number(state.width);
        const height = Number(state.height);
        const half = Number.isFinite(width) && width > 0 ? Math.min(width / 2, 2) : 0.4;
        const tall = Number.isFinite(height) && height > 0 ? Math.min(height, 4) : 1.8;
        return { x: position[0], y: position[1], z: position[2], half, tall };
    }
    function project(x, y, z, m, rect) {
        const w = x * m[3] + y * m[7] + z * m[11] + m[15];
        if (w <= 0.01) return null;
        const clipX = x * m[0] + y * m[4] + z * m[8] + m[12];
        const clipY = x * m[1] + y * m[5] + z * m[9] + m[13];
        const nx = clipX / w;
        const ny = clipY / w;
        if (!Number.isFinite(nx) || !Number.isFinite(ny) || Math.abs(nx) > 10 || Math.abs(ny) > 10) return null;
        return {
            x: rect.left + (nx + 1) * rect.width / 2,
            y: rect.top + (1 - ny) * rect.height / 2
        };
    }
    function drawBox(box, matrix, rect) {
        const { x, y, z, half, tall } = box;
        const points = [];
        for (let i = 0; i < 8; i++) {
            points.push(project(
                x + (i & 1 ? half : -half),
                y + (i & 4 ? tall : 0),
                z + (i & 2 ? half : -half),
                matrix,
                rect
            ));
        }
        ctx.beginPath();
        let drawn = false;
        for (const [a, b] of EDGES) {
            if (!points[a] || !points[b]) continue;
            ctx.moveTo(points[a].x, points[a].y);
            ctx.lineTo(points[b].x, points[b].y);
            drawn = true;
        }
        if (drawn) {
            boxesDrawn++;
            ctx.lineWidth = 3;
            ctx.strokeStyle = "rgba(0,0,0,.78)";
            ctx.stroke();
            ctx.lineWidth = 1.5;
            ctx.strokeStyle = "#ff465d";
            ctx.stroke();
        }
    }
    function resizeOverlay() {
        const dpr = Math.min(W.devicePixelRatio || 1, 2);
        const width = Math.max(1, Math.round(W.innerWidth * dpr));
        const height = Math.max(1, Math.round(W.innerHeight * dpr));
        if (overlay.width !== width || overlay.height !== height) {
            overlay.width = width;
            overlay.height = height;
        }
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    function draw(now) {
        if (!overlay || !enabled || now - lastFrame < FRAME_MS) return;
        lastFrame = now;
        resizeOverlay();
        ctx.clearRect(0, 0, W.innerWidth, W.innerHeight);
        boxesDrawn = 0;
        refreshPlayers(now);
        if (!noa || !playerIds.length) return;
        hookCamera();
        aimAtNearest(noa.camera, now);
        try {
            const scene =
                noa.Lb?.JKO?.() ||
                noa.Lb?.Ce ||
                noa.rendering?.getScene?.();
            if (!scene) return;
            const matrix = scene.getTransformMatrix()?.m;
            const gameCanvas = noa.container?.canvas || scene.getEngine?.()?.getRenderingCanvas?.();
            const rect = gameCanvas?.getBoundingClientRect?.() || {
                left: 0, top: 0, width: W.innerWidth, height: W.innerHeight
            };
            if (!matrix || matrix.length !== 16 || !rect.width || !rect.height) return;
            for (const id of playerIds) {
                const box = playerBox(id);
                if (box) drawBox(box, matrix, rect);
            }
        } catch (_) {
        }
    }
    let attackController = null;
    let lastControllerSearch = 0;
    function findAttackController(now) {
        if (attackController?.tryHitEntity) return attackController;
        if (!noa || now - lastControllerSearch < 1000) return null;
        lastControllerSearch = now;
        const queue = [{ value: noa.entities, depth: 0 }, { value: noa.playerEntity, depth: 0 }];
        const seen = new Set();
        let checked = 0;
        for (let head = 0; head < queue.length && checked < 1500; head++) {
            const { value, depth } = queue[head];
            if (!value || typeof value !== "object" || seen.has(value)) continue;
            seen.add(value);
            checked++;
            if (typeof value.tryHitEntity === "function") {
                attackController = value;
                return value;
            }
            if (depth >= 5 || ArrayBuffer.isView(value)) continue;
            let keys;
            try { keys = Object.keys(value); } catch (_) { continue; }
            if (keys.length > 250) continue;
            for (const key of keys) {
                let child;
                try { child = value[key]; } catch (_) { continue; }
                if (child && typeof child === "object" && !seen.has(child)) {
                    queue.push({ value: child, depth: depth + 1 });
                }
            }
        }
        return null;
    }
    function rayHitsBox(origin, direction, box, limit) {
        const low = [box.x - box.half, box.y, box.z - box.half];
        const high = [box.x + box.half, box.y + box.tall, box.z + box.half];
        let near = 0;
        let far = limit;
        for (let i = 0; i < 3; i++) {
            if (Math.abs(direction[i]) < 1e-8) {
                if (origin[i] < low[i] || origin[i] > high[i]) return false;
            } else {
                let a = (low[i] - origin[i]) / direction[i];
                let b = (high[i] - origin[i]) / direction[i];
                if (a > b) [a, b] = [b, a];
                near = Math.max(near, a);
                far = Math.min(far, b);
                if (near > far) return false;
            }
        }
        return true;
    }
    function aimedAtPlayer(now) {
        const controller = findAttackController(now);
        if (controller) {
            try {
                const hit = controller.tryHitEntity();
                const id = Number(hit?.hitEId);
                if (Number.isFinite(id) && playerIds.includes(id)) {
                    if (noa.entities.getState(id, "genericLifeformState")?.isAlive !== false) {
                        return true;
                    }
                }
            } catch (_) {}
        }
        const camera = noa?.camera;
        const self = ownPosition();
        const useGlobal = !!self;
        const eye = useGlobal
            ? [self[0], self[1] + 1.6, self[2]]
            : vec3(camera?.AbO?.() || camera?._localGetTargetPosition?.());
        const heading = Number(camera?.heading);
        const pitch = Number(camera?.pitch);
        if (!eye || !Number.isFinite(heading) || !Number.isFinite(pitch)) return false;
        const direction = [
            Math.sin(heading) * Math.cos(pitch),
            -Math.sin(pitch),
            Math.cos(heading) * Math.cos(pitch)
        ];
        for (const id of playerIds) {
            const p = useGlobal ? globalPosition(id) : null;
            const box = p
                ? { x: p[0], y: p[1], z: p[2], half: 0.4, tall: 1.8 }
                : playerBox(id);
            if (box && rayHitsBox(eye, direction, box, 4.5)) return true;
        }
        return false;
    }
    function triggerTick(now) {
        if (!triggerEnabled || !noa || !document.pointerLockElement ||
            now - lastTrigger < TRIGGER_MS) return;
        refreshPlayers(now);
        if (!playerIds.length || !aimedAtPlayer(now)) return;
        const down = noa.inputs?.down;
        const up = noa.inputs?.up;
        const directDown = down?._events?.["primary-fire"];
        const directUp = up?._events?.["primary-fire"];
        if (typeof directDown !== "function" && typeof down?.emit !== "function") return;
        const event = {
            timeStamp: now, altKey: false, ctrlKey: false,
            shiftKey: false, metaKey: false, button: 0, buttons: 1,
            clientX: W.innerWidth / 2, clientY: W.innerHeight / 2,
            screenX: W.screen.width / 2, screenY: W.screen.height / 2,
            preventDefault() {}, stopPropagation() {}
        };
        try {
            if (typeof directDown === "function") down._events["primary-fire"](0);
            else down.emit("primary-fire", event);
            if (typeof directUp === "function" || typeof up?.emit === "function") {
                W.setTimeout(() => {
                    try {
                        if (typeof directUp === "function") up._events["primary-fire"](0);
                        else up.emit("primary-fire", event);
                    } catch (_) {}
                }, 35);
            }
            lastTrigger = now;
            lastTriggerHit = now;
        } catch (_) {}
    }
    function findPickupQuery() {
        const entities = noa?.entities;
        if (!entities) return null;
        const candidates = [];
        let object = entities;
        for (let level = 0; object && level < 4; level++, object = Object.getPrototypeOf(object)) {
            candidates.push(object);
        }
        for (const owner of candidates) {
            for (const key of Reflect.ownKeys(owner)) {
                if (key === "constructor") continue;
                let fn;
                try { fn = Object.getOwnPropertyDescriptor(owner, key)?.value; } catch (_) {}
                if (typeof fn !== "function") continue;
                let source;
                try { source = Function.prototype.toString.call(fn).replace(/\s+/g, ""); }
                catch (_) { continue; }
                if (key === "DVO" || key === "getEntitiesInAABB" ||
                    (source.includes("this.names.position") && source.includes(".base[0]"))) {
                    return { owner, key, original: fn };
                }
                if (fn.prototype) {
                    for (const innerKey of Reflect.ownKeys(fn.prototype)) {
                        const inner = Object.getOwnPropertyDescriptor(fn.prototype, innerKey)?.value;
                        if (typeof inner !== "function") continue;
                        let innerSource;
                        try { innerSource = Function.prototype.toString.call(inner).replace(/\s+/g, ""); }
                        catch (_) { continue; }
                        if (innerSource.includes("this.names.position") && innerSource.includes(".base[0]")) {
                            return { owner: fn.prototype, key: innerKey, original: inner };
                        }
                    }
                }
            }
        }
        return null;
    }
    function removePickup() {
        if (!pickupPatch) return;
        const { owner, key, wrapper, descriptor } = pickupPatch;
        try {
            if (owner[key] === wrapper) {
                if (descriptor) Object.defineProperty(owner, key, descriptor);
                else delete owner[key];
            }
        } catch (_) {}
        pickupPatch = null;
    }
    function installPickup() {
        if (!pickupEnabled || !noa) return;
        if (pickupPatch && pickupPatch.owner[pickupPatch.key] === pickupPatch.wrapper) return;
        removePickup();
        const found = findPickupQuery();
        if (!found) return;
        const { owner, key, original } = found;
        const descriptor = Object.getOwnPropertyDescriptor(owner, key);
        function wrapper(box, name) {
            if (!pickupEnabled || !box?.base || !box?.max) {
                return Reflect.apply(original, this, arguments);
            }
            const center = [0, 1, 2].map(i => (box.base[i] + box.max[i]) / 2);
            const half = [0, 1, 2].map(i => (box.max[i] - box.base[i]) / 2);
            const enlarged = {
                base: center.map((c, i) => c - half[i] * PICKUP_FACTOR),
                max: center.map((c, i) => c + half[i] * PICKUP_FACTOR)
            };
            return Reflect.apply(original, this, [enlarged, name]);
        }
        try {
            owner[key] = wrapper;
            if (owner[key] === wrapper) pickupPatch = { owner, key, wrapper, descriptor };
        } catch (_) {}
    }
    function setEnabled(value) {
        enabled = value;
        toggle.textContent = enabled ? "AIM BOT: AN" : "AIM BOT: AUS";
        toggle.style.background = enabled ? "#174437" : "#202b38";
        toggle.style.borderColor = enabled ? "#46d99a" : "#47596b";
        toggle.style.color = enabled ? "#b5ffdb" : "#e4edf5";
        if (!enabled && ctx) ctx.clearRect(0, 0, W.innerWidth, W.innerHeight);
        lastFrame = 0;
        lastPlayers = 0;
        lastTarget = 0;
        nearestId = null;
        lastAim = 0;
    }
    function saveExtraKeys() {
        try {
            W.localStorage.setItem(EXTRA_KEY_STORAGE, JSON.stringify({
                trigger: triggerKey, pickup: pickupHotkey
            }));
        } catch (_) {}
    }
    function updateExtraButtons() {
        if (!triggerToggle || !pickupToggle) return;
        for (const [button, on, label] of [
            [triggerToggle, triggerEnabled, "TRIGGER BOT"],
            [pickupToggle, pickupEnabled, "PICKUP REACH"]
        ]) {
            button.textContent = label + (on ? ": AN" : ": AUS");
            button.style.background = on ? "#174437" : "#202b38";
            button.style.borderColor = on ? "#46d99a" : "#47596b";
            button.style.color = on ? "#b5ffdb" : "#e4edf5";
        }
        triggerKeyButton.textContent = waitingExtra === "trigger" ? "…" : triggerKey?.label || "–";
        pickupKeyButton.textContent = waitingExtra === "pickup" ? "…" : pickupHotkey?.label || "–";
        triggerClearButton.disabled = !triggerKey;
        pickupClearButton.disabled = !pickupHotkey;
        triggerClearButton.style.opacity = triggerKey ? "1" : ".35";
        pickupClearButton.style.opacity = pickupHotkey ? "1" : ".35";
    }
    function setTrigger(value) {
        triggerEnabled = value;
        lastTrigger = 0;
        updateExtraButtons();
    }
    function setPickup(value) {
        pickupEnabled = value;
        if (value) installPickup();
        else removePickup();
        updateExtraButtons();
    }
    function extraRow(id, label, onToggle) {
        const row = document.createElement("div");
        row.style.cssText = "display:flex;align-items:center;gap:5px;margin-top:7px";
        const button = document.createElement("button");
        button.type = "button";
        button.style.cssText = toggle.style.cssText;
        button.addEventListener("click", onToggle);
        const key = document.createElement("button");
        key.type = "button";
        key.title = "Taste für " + label + " auswählen";
        key.style.cssText = keyButton.style.cssText;
        key.addEventListener("click", () => {
            waitingExtra = id;
            waitingForKey = false;
            updateKeyButton();
            updateExtraButtons();
            if (document.pointerLockElement) document.exitPointerLock?.();
        });
        const clear = document.createElement("button");
        clear.type = "button";
        clear.title = "Taste löschen";
        clear.textContent = "×";
        clear.style.cssText = clearKeyButton.style.cssText;
        clear.addEventListener("click", () => {
            if (id === "trigger") triggerKey = null;
            else pickupHotkey = null;
            if (waitingExtra === id) waitingExtra = null;
            saveExtraKeys();
            updateExtraButtons();
        });
        row.append(button, key, clear);
        return { row, button, key, clear };
    }
    function updateStatus(now) {
        if (!status) return;
        if (waitingForKey || waitingExtra) {
            status.textContent = "Taste drücken · Esc: abbrechen";
        } else if (!enabled && !triggerEnabled && !pickupEnabled) {
            status.textContent = "Rechte Umschalttaste: Menü";
        } else if (!noa) {
            status.textContent = "Engine wird gesucht …";
        } else if (enabled && now - lastAim < 500) {
            status.textContent = `Ziel aktiv · ${boxesDrawn} Kästen im Bild`;
        } else if (triggerEnabled && now - lastTriggerHit < 800) {
            status.textContent = "Trigger Bot: Angriff gesendet";
        } else if (pickupEnabled && !pickupPatch) {
            status.textContent = "Pickup Reach: Abfrage wird gesucht";
        } else if (triggerEnabled &&
            typeof noa.inputs?.down?._events?.["primary-fire"] !== "function" &&
            typeof noa.inputs?.down?.emit !== "function") {
            status.textContent = "Trigger Bot: Spieleingabe fehlt";
        } else if (triggerEnabled && !enabled) {
            status.textContent = "Trigger Bot: Ziel anvisieren";
        } else if (pickupEnabled && !enabled) {
            status.textContent = "Pickup Reach aktiv";
        } else if (!enabled) {
            status.textContent = "Rechte Umschalttaste: Menü";
        } else if (!noa.camera) {
            status.textContent = "Kamera wird gesucht …";
        } else if (!playerIds.length || nearestId === null) {
            status.textContent = `Aim: ${lastAimReason || "Keine Spielerposition geladen"} · IDs ${playerIds.length}`;
        } else {
            status.textContent = hookedCameraMethod
                ? "Warte auf Kameradaten"
                : "Kamera-Hook fehlt · Direktmodus aktiv";
        }
    }
    function createUI() {
        if (!document.body || overlay) return;
        overlay = document.createElement("canvas");
        overlay.id = "bloxd-player-esp-overlay";
        overlay.style.cssText = "position:fixed;inset:0;width:100vw;height:100vh;z-index:2147483644;pointer-events:none";
        ctx = overlay.getContext("2d", { alpha: true });
        menu = document.createElement("div");
        menu.id = "bloxd-player-esp-menu";
        menu.style.cssText = "position:fixed;top:24px;right:24px;z-index:2147483645;width:250px;padding:12px;background:rgba(8,18,29,.94);border:1px solid #354c60;border-radius:10px;box-shadow:0 8px 28px #0008;color:#eef6ff;font-family:Arial,sans-serif;user-select:none";
        const title = document.createElement("div");
        title.textContent = "AIM BOT · v1.8";
        title.style.cssText = "font:800 12px Arial;margin-bottom:10px";
        const row = document.createElement("div");
        row.style.cssText = "display:flex;align-items:center;gap:5px";
        toggle = document.createElement("button");
        toggle.type = "button";
        toggle.style.cssText = "flex:1;min-width:0;height:34px;border:1px solid #47596b;border-radius:7px;font:800 11px Arial;cursor:pointer";
        toggle.addEventListener("click", () => setEnabled(!enabled));
        keyButton = document.createElement("button");
        keyButton.type = "button";
        keyButton.title = "Taste für Aim Bot auswählen";
        keyButton.style.cssText = "width:28px;height:28px;flex:0 0 auto;padding:0;border:1px solid #47596b;border-radius:6px;background:#202b38;color:#e4edf5;font:800 12px Arial;cursor:pointer";
        keyButton.addEventListener("click", () => {
            waitingForKey = true;
            waitingExtra = null;
            updateKeyButton();
            updateExtraButtons();
            if (document.pointerLockElement) document.exitPointerLock?.();
        });
        clearKeyButton = document.createElement("button");
        clearKeyButton.type = "button";
        clearKeyButton.title = "Ausgewählte Taste löschen";
        clearKeyButton.textContent = "×";
        clearKeyButton.style.cssText = "width:20px;height:20px;flex:0 0 auto;padding:0;border:1px solid #47596b;border-radius:5px;background:#202b38;color:#e4edf5;font:800 14px Arial;cursor:pointer";
        clearKeyButton.addEventListener("click", () => {
            waitingForKey = false;
            selectedKey = null;
            saveKey();
            updateKeyButton();
        });
        row.append(toggle, keyButton, clearKeyButton);
        const triggerRow = extraRow("trigger", "Trigger Bot", () => setTrigger(!triggerEnabled));
        const pickupRow = extraRow("pickup", "Pickup Reach", () => setPickup(!pickupEnabled));
        triggerToggle = triggerRow.button;
        triggerKeyButton = triggerRow.key;
        triggerClearButton = triggerRow.clear;
        pickupToggle = pickupRow.button;
        pickupKeyButton = pickupRow.key;
        pickupClearButton = pickupRow.clear;
        status = document.createElement("div");
        status.style.cssText = "font:700 9px Arial;color:#a8bdd0;margin-top:8px";
        menu.append(title, row, triggerRow.row, pickupRow.row, status);
        document.body.append(overlay, menu);
        setEnabled(false);
        updateKeyButton();
        updateExtraButtons();
        updateStatus(performance.now());
    }
    document.addEventListener("keydown", event => {
        if (waitingExtra) {
            if (event.repeat) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            if (event.code === "Escape") {
                waitingExtra = null;
            } else if (event.code !== "ShiftRight" && !event.ctrlKey &&
                !event.altKey && !event.metaKey && event.code &&
                Array.from(event.key || "").length === 1) {
                const next = {
                    code: event.code,
                    label: event.key === " " ? "␣" : event.key.toLocaleUpperCase("de-DE")
                };
                if (selectedKey?.code === next.code) {
                    selectedKey = null;
                    saveKey();
                }
                if (waitingExtra === "trigger") {
                    triggerKey = next;
                    if (pickupHotkey?.code === next.code) pickupHotkey = null;
                } else {
                    pickupHotkey = next;
                    if (triggerKey?.code === next.code) triggerKey = null;
                }
                waitingExtra = null;
                saveExtraKeys();
                updateKeyButton();
            }
            updateExtraButtons();
            return;
        }
        if (waitingForKey) {
            if (event.repeat) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            if (event.code === "Escape") {
                waitingForKey = false;
                updateKeyButton();
                return;
            }
            if (event.code === "ShiftRight" || event.ctrlKey || event.altKey || event.metaKey) {
                return;
            }
            if (event.code && Array.from(event.key || "").length === 1) {
                selectedKey = {
                    code: event.code,
                    label: event.key === " " ? "LEER" : event.key.toLocaleUpperCase("de-DE")
                };
                if (triggerKey?.code === event.code) triggerKey = null;
                if (pickupHotkey?.code === event.code) pickupHotkey = null;
                saveExtraKeys();
                waitingForKey = false;
                saveKey();
                updateKeyButton();
                updateExtraButtons();
            }
            return;
        }
        if (event.code === "ShiftRight" && !event.repeat) {
            if (!menu) createUI();
            if (!menu) return;
            const show = menu.style.display === "none";
            menu.style.display = show ? "block" : "none";
            if (show && document.pointerLockElement) document.exitPointerLock?.();
            return;
        }
        if (selectedKey && event.code === selectedKey.code && !event.repeat && !isTyping(event)) {
            event.preventDefault();
            event.stopImmediatePropagation();
            setEnabled(!enabled);
            return;
        }
        if (!event.repeat && !isTyping(event) && triggerKey?.code === event.code) {
            event.preventDefault();
            event.stopImmediatePropagation();
            setTrigger(!triggerEnabled);
            return;
        }
        if (!event.repeat && !isTyping(event) && pickupHotkey?.code === event.code) {
            event.preventDefault();
            event.stopImmediatePropagation();
            setPickup(!pickupEnabled);
        }
    }, true);
    function loop(now) {
        if (now - lastEngineCheck >= 500) {
            lastEngineCheck = now;
            if (!noa) noa = findNoa();
            if (noa) hookCamera();
        }
        if (pickupEnabled && now - lastPickupSearch >= 500) {
            lastPickupSearch = now;
            installPickup();
        }
        triggerTick(now);
        draw(now);
        updateStatus(now);
        W.requestAnimationFrame(loop);
    }
    captureNoa();
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", createUI, { once: true });
    } else {
        createUI();
    }
    W.requestAnimationFrame(loop);
})();
