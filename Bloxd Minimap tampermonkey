function invalidateMap(){

    mapData=null;

    mapCX=null;
    mapCZ=null;

    mapSeed=null;
    mapModeBuilt=null;
    mapYBuilt=null;
}


function mapValid(
    cx,
    cz,
    s,
    m,
    y
){

    return(
        !!mapData&&
        mapCX===cx&&
        mapCZ===cz&&
        String(mapSeed)===
        String(s)&&
        mapModeBuilt===m&&
        (
            m!=="layer"||
            mapYBuilt===y
        )
    );
}


async function batches(
    jobs,
    size=6,
    pause=4
){

    for(
        let i=0;
        i<jobs.length;
        i+=size
    ){

        await Promise.all(
            jobs
                .slice(
                    i,
                    i+size
                )
                .map(
                    j=>
                        chunk(
                            j.s,
                            j.cx,
                            j.cy,
                            j.cz
                        )
                )
        );

        await sleep(pause);
    }
}


function queueMap(force){

    if(
        !ready||
        !current
    ){
        return;
    }

    const cx=
        snap(
            Math.floor(current.x)
        );

    const cz=
        snap(
            Math.floor(current.z)
        );

    const s=
        seed();

    const y=
        layerY();

    if(
        !force&&
        mapValid(
            cx,
            cz,
            s,
            mode,
            y
        )
    ){
        return;
    }

    if(buildRun){

        buildQueued=true;
        return;
    }

    buildMap(
        cx,
        cz,
        radius+MARGIN,
        s,
        mode,
        y
    );
}


async function buildMap(
    cx,
    cz,
    r,
    s,
    m,
    y
){

    const token=
        ++buildToken;

    buildRun=true;
    buildQueued=false;

    updateState();

    const minX=
        floorDiv(
            cx-r,
            CS
        );

    const maxX=
        floorDiv(
            cx+r,
            CS
        );

    const minZ=
        floorDiv(
            cz-r,
            CS
        );

    const maxZ=
        floorDiv(
            cz+r,
            CS
        );

    const minY=
        m==="surface"
            ?SURF_MIN
            :floorDiv(
                y,
                CS
            );

    const maxY=
        m==="surface"
            ?SURF_MAX
            :minY;

    const jobs=[];

    for(
        let x=minX;
        x<=maxX;
        x++
    ){

        for(
            let z=minZ;
            z<=maxZ;
            z++
        ){

            for(
                let yy=minY;
                yy<=maxY;
                yy++
            ){

                jobs.push({

                    s,

                    cx:
                        x,

                    cy:
                        yy,

                    cz:
                        z
                });
            }
        }
    }

    try{

        await batches(
            jobs
        );

        if(
            token!==
            buildToken
        ){
            return;
        }

        const built=
            m==="surface"

                ?surfaceArray(
                    s,
                    cx,
                    cz,
                    r
                )

                :layerArray(
                    s,
                    cx,
                    cz,
                    r,
                    y
                );

        if(
            token!==
            buildToken
        ){
            return;
        }

        mapData=built;

        mapCX=cx;
        mapCZ=cz;

        mapSeed=s;

        mapModeBuilt=m;

        mapYBuilt=
            m==="layer"
                ?y
                :null;

        error=null;

    }catch(e){

        if(
            e?.message!==
            "Seed changed"
        ){

            error=
                e.message||
                String(e);

            console.error(e);
        }

    }finally{

        if(
            token===
            buildToken
        ){

            buildRun=false;

            updateState();

            if(buildQueued){

                buildQueued=false;

                setTimeout(
                    ()=>
                        queueMap(true),
                    100
                );
            }
        }
    }
}


