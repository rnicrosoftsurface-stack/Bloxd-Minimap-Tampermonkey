// ==========================================================

function num(t){

    const s=
        String(t)
            .trim()
            .replace(",",".");

    if(
        !/^[+-]?(?:\d+(?:\.\d+)?|\.\d+)$/.test(s)
    ){
        return null;
    }

    const n=
        Number(s);

    return Number.isFinite(n)
        ?n
        :null;
}


function triple(t){

    const m=
        String(t)
            .trim()
            .replace(/,/g,".")
            .match(
                /([+-]?\d+(?:\.\d+)?)\s+([+-]?\d+(?:\.\d+)?)\s+([+-]?\d+(?:\.\d+)?)/
            );

    if(!m)
        return null;

    const a=[
        +m[1],
        +m[2],
        +m[3]
    ];

    return a.every(Number.isFinite)
        ?a
        :null;
}


function posScore(a,b,c){

    if(Math.abs(b.n)>2048)
        return-Infinity;

    let s=
        Math.log10(1+Math.abs(a.n))+
        Math.log10(1+Math.abs(c.n));

    if(Math.abs(b.n)<=512)
        s+=6;

    if(
        Math.abs(a.n)>256||
        Math.abs(c.n)>256
    ){
        s+=3;
    }

    if(String(a.raw).includes("."))
        s+=.5;

    if(String(c.raw).includes("."))
        s+=.5;

    return s;
}


function inspect(
    canvasEl,
    raw,
    n,
    x,
    y
){

    const now=
        performance.now();

    let a=
        calls.get(canvasEl);

    if(!a){

        a=[];

        calls.set(
            canvasEl,
            a
        );
    }

    a.push({
        n,
        x:+x,
        y:+y,
        t:now,
        raw:String(raw)
    });

    while(
        a.length&&
        now-a[0].t>120
    ){
        a.shift();
    }

    if(a.length<3)
        return;

    let best=null;
    let bs=-Infinity;

    const pref=
        /coordinate/i.test(
            String(
                canvasEl.className||""
            )
        );

    for(
        let i=0;
        i<a.length-2;
        i++
    ){

        for(
            let j=i+1;
            j<a.length-1;
            j++
        ){

            for(
                let k=j+1;
                k<a.length;
                k++
            ){

                const p=
                    [
                        a[i],
                        a[j],
                        a[k]
                    ]
                    .sort(
                        (u,v)=>
                            u.x-v.x
                    );

                if(
                    Math.max(
                        p[0].y,
                        p[1].y,
                        p[2].y
                    )
                    -
                    Math.min(
                        p[0].y,
                        p[1].y,
                        p[2].y
                    )
                    >
                    10
                ){
                    continue;
                }

                if(
                    !(
                        p[0].x<p[1].x&&
                        p[1].x<p[2].x
                    )
                ){
                    continue;
                }

                const s=
                    posScore(
                        p[0],
                        p[1],
                        p[2]
                    )
                    +
                    (
                        pref
                            ?20
                            :0
                    );

                if(s>bs){

                    bs=s;
                    best=p;
                }
            }
        }
    }

    if(
        best&&
        bs>7
    ){

        accept(
            best[0].n,
            best[1].n,
            best[2].n
        );
    }
}


function hook(){

    const P=
        W.CanvasRenderingContext2D&&
        W.CanvasRenderingContext2D.prototype;

    if(
        !P||
        P.__bloxdMapHook39
    ){
        return;
    }

    const orig=
        P.fillText;

    Object.defineProperty(
        P,
        "__bloxdMapHook39",
        {
            value:true,
            configurable:true
        }
    );

    P.fillText=
        function(
            t,
            x,
            y,
            m
        ){

            try{

                const q=
                    triple(t);

                if(q){

                    accept(
                        q[0],
                        q[1],
                        q[2]
                    );

                }else{

                    const n=
                        num(t);

                    if(
                        n!==null&&
                        this?.canvas
                    ){

                        inspect(
                            this.canvas,
                            t,
                            n,
                            x,
                            y
                        );
                    }
                }

            }catch(_){}

            return arguments.length>=4
                ?orig.call(
                    this,
                    t,
                    x,
                    y,
                    m
                )
                :orig.call(
                    this,
                    t,
                    x,
                    y
                );
        };
}


function currentSnap(){

    if(!current)
        return null;

    return{
        x:
            snap(
                Math.floor(current.x)
            ),

        z:
            snap(
                Math.floor(current.z)
            )
    };
}


function accept(x,y,z){

    if(
        ![x,y,z].every(Number.isFinite)||
        Math.abs(y)>10000||
        Math.abs(x)>1e9||
        Math.abs(z)>1e9
    ){
        return;
    }

    const oldY=
        layerY();

    const os=
        currentSnap();

    const oldChunk=
        current
            ?`${floorDiv(current.x,CS)}|${floorDiv(current.y,CS)}|${floorDiv(current.z,CS)}`
            :null;

    current={
        x,
        y,
        z
    };

    lastSeen=
        performance.now();

    const ns=
        currentSnap();

    const areaChanged=
        !os||
        os.x!==ns.x||
        os.z!==ns.z;

    const yChanged=
        oldY!==layerY();

    const newChunk=
        `${floorDiv(x,CS)}|${floorDiv(y,CS)}|${floorDiv(z,CS)}`;

    if(
        mode==="layer"&&
        yChanged
    ){

        invalidateMap();
        queueMap(true);

    }else{

        queueMap(false);
    }

    if(
        (
            showY1&&
            yChanged
        )
        ||
        (
            (
                showY1||
                showAllOres
            )
            &&
            areaChanged
        )
    ){

        invalidateOres();
        queueOres(true);

    }else if(
        showY1||
        showAllOres
    ){

        queueOres(false);
    }

    if(
        showSpawner&&
        areaChanged
    ){

        invalidateStructures();
        queueStructures(true);

    }else if(showSpawner){

        queueStructures(false);
    }

    if(
        chunkDetails?.open&&
        oldChunk!==newChunk
    ){

        queueChunkStats(true);
    }

    updateText();
}


