async function init(){

    try{

        updateState(
            "ENGINE LOAD"
        );

        const[
            w,
            b,
            i
        ]=
            await Promise.all([

                getText(
                    `${BASE}/webWorkerBloxd.js`
                ),

                getText(
                    `${BASE}/blockMetadata.js`
                ),

                getText(
                    `${BASE}/itemMetadata.js`
                )
            ]);

        workerFn=
            extract(
                w,
                "webWorkerCodeFunction"
            );

        bmd=
            extract(
                b,
                "bmd"
            );

        imd=
            extract(
                i,
                "imd"
            );

        if(
            !workerFn||
            !bmd||
            !imd
        ){

            throw new Error(
                "Generator konnte nicht geladen werden"
            );
        }

        buildIndex();
        createWorker();

        ready=true;
        error=null;

        updateState();

        if(current)
            queueMap(true);

    }catch(e){

        ready=false;

        error=
            e.message||
            String(e);

        console.error(e);

        updateState();
    }
}


