function createWorker(){

    if(worker)
        worker.terminate();

    const blob=
        new Blob(
            [
                "("+
                workerFn.toString()+
                ")()"
            ],
            {
                type:
                    "application/javascript"
            }
        );

    worker=
        new Worker(
            URL.createObjectURL(
                blob
            )
        );

    workerSeed=null;

    worker.postMessage({

        type:
            "workerInit",

        chunkSize:
            32,

        itemMetadata:
            imd,

        blockMetadata:
            bmd
    });

    worker.onmessage=
        e=>{

            const r=
                e.data;

            if(
                !r||
                r.type!=="chunkResponse"
            ){
                return;
            }

            for(
                const[
                    k,
                    q
                ]
                of
                pending
            ){

                if(q.id!==r.id)
                    continue;

                pending.delete(k);

                const raw=
                    r.array?.data;

                const d=
                    raw instanceof Uint16Array

                        ?raw

                        :new Uint16Array(
                            raw?.buffer||
                            raw||
                            []
                        );

                // WICHTIG:
                // metadata enthält specialBlocks und damit die Loot-Chests.
                const ch={

                    cx:
                        q.cx,

                    cy:
                        q.cy,

                    cz:
                        q.cz,

                    data:
                        d,

                    metadata:
                        r.metadata||
                        null
                };

                chunks.set(
                    k,
                    ch
                );

                while(
                    chunks.size>
                    MAX_CACHE
                ){

                    chunks.delete(
                        chunks
                            .keys()
                            .next()
                            .value
                    );
                }

                q.resolve(ch);

                break;
            }
        };

    worker.onerror=
        e=>{

            error=
                "Worker error";

            console.error(e);

            updateState();
        };
}


function setSeed(s){

    if(
        String(workerSeed)===
        String(s)
    ){
        return;
    }

    for(
        const q
        of
        pending.values()
    ){

        try{

            q.reject(
                new Error(
                    "Seed changed"
                )
            );

        }catch(_){}
    }

    pending.clear();
    chunks.clear();
    chunkStatsCache.clear();

    invalidateMap();
    invalidateOres();
    invalidateStructures();

    worker.postMessage({

        type:
            "createSeed",

        seed:
            s,

        dN:
            1,

        oN:
            1
    });

    workerSeed=s;
}


function chunk(
    s,
    cx,
    cy,
    cz
){

    const k=
        key(
            s,
            cx,
            cy,
            cz
        );

    if(chunks.has(k)){

        return Promise.resolve(
            chunks.get(k)
        );
    }

    if(pending.has(k)){

        return pending
            .get(k)
            .promise;
    }

    setSeed(s);

    const id=
        `${cx*32}|${cy*32}|${cz*32}|${s}`;

    let resolvePromise;
    let rejectPromise;

    const promise=
        new Promise(
            (
                a,
                b
            )=>{

                resolvePromise=a;
                rejectPromise=b;
            }
        );

    pending.set(
        k,
        {
            id,
            cx,
            cy,
            cz,

            resolve:
                resolvePromise,

            reject:
                rejectPromise,

            promise
        }
    );

    worker.postMessage({

        id,

        type:
            "chunk",

        array:{

            data:
                new Uint16Array(
                    32768
                ),

            shape:[
                32,
                32,
                32
            ],

            stride:[
                1024,
                32,
                1
            ],

            offset:
                0
        }
    });

    return promise;
}


function getBlock(
    s,
    x,
    y,
    z
){

    const cx=
        floorDiv(
            x,
            CS
        );

    const cy=
        floorDiv(
            y,
            CS
        );

    const cz=
        floorDiv(
            z,
            CS
        );

    const ch=
        chunks.get(
            key(
                s,
                cx,
                cy,
                cz
            )
        );

    if(!ch)
        return null;

    const lx=
        mod(
            x,
            CS
        );

    const ly=
        mod(
            y,
            CS
        );

    const lz=
        mod(
            z,
            CS
        );

    return ch.data[
        lx*1024+
        ly*32+
        lz
    ];
}


// ==========================================================
// SURFACE
// ==========================================================

function topBlockDetailed(
    s,
    x,
    z
){

    const cx=
        floorDiv(x,CS);

    const cz=
        floorDiv(z,CS);

    const lx=
        mod(x,CS);

    const lz=
        mod(z,CS);

    const base=
        lx*1024+
        lz;

    let deco=0;

    for(
        let cy=SURF_MAX;
        cy>=SURF_MIN;
        cy--
    ){

        const ch=
            chunks.get(
                key(
                    s,
                    cx,
                    cy,
                    cz
                )
            );

        if(!ch)
            continue;

        for(
            let ly=31;
            ly>=0;
            ly--
        ){

            const id=
                ch.data[
                    base+
                    ly*32
                ];

            const wy=
                cy*32+
                ly;

            if(isAir(id))
                continue;

            if(isDecoration(id)){

                if(!deco)
                    deco=id;

                continue;
            }

            return{
                id,
                y:wy,
                deco
            };
        }
    }

    return{
        id:0,
        y:
            SURF_MIN*
            32,
        deco
    };
}


function surfaceArray(
    s,
    cx,
    cz,
    r
){

    const size=
        r*2+1;

    const out=
        Array.from(
            {
                length:
                    size
            },
            ()=>
                new Array(
                    size
                )
        );

    for(
        let row=0;
        row<size;
        row++
    ){

        const x=
            cx+r-row;

        for(
            let col=0;
            col<size;
            col++
        ){

            const z=
                cz+r-col;

            const t=
                topBlockDetailed(
                    s,
                    x,
                    z
                );

            out[row][col]={

                x,

                z,

                id:
                    t.id,

                y:
                    t.y,

                deco:
                    t.deco||
                    0
            };
        }
    }

    return out;
}


function layerArray(
    s,
    cx,
    cz,
    r,
    y
){

    const size=
        r*2+1;

    const out=
        Array.from(
            {
                length:
                    size
            },
            ()=>
                new Array(
                    size
                )
        );

    for(
        let row=0;
        row<size;
        row++
    ){

        const x=
            cx+r-row;

        for(
            let col=0;
            col<size;
            col++
        ){

            const z=
                cz+r-col;

            const id=
                getBlock(
                    s,
                    x,
                    y,
                    z
                );

            out[row][col]={

                x,

                z,

                id:
                    id??0,

                y,

                deco:
                    0
            };
        }
    }

    return out;
}


