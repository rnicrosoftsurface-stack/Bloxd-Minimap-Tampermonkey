function noise(
    x,
    z,
    id
){

    let n=
        Math.imul(
            x,
            374761393
        );

    n^=
        Math.imul(
            z,
            668265263
        );

    n^=
        Math.imul(
            Number(id)+1,
            1442695041
        );

    n=
        Math.imul(
            n^(n>>>13),
            1274126177
        );

    n^=
        n>>>16;

    return(
        (n>>>0)/
        4294967295
    )-.5;
}


