function invalidateOres(){

    y1OrePts=[];
    allOrePts=[];

    oreCX=null;
    oreCZ=null;
    oreR=null;
    oreSeed=null;
    oreBaseY=null;
}


function oresValid(
    cx,
    cz,
    r,
    s,
    y
){

    if(
        oreCX!==cx||
        oreCZ!==cz||
        oreR!==r||
        String(oreSeed)!==
        String(s)
    ){
        return false;
    }

    if(
        showY1&&
        oreBaseY!==y
    ){
        return false;
    }

    return true;
}


function queueOres(force){

    if(
        !ready||
        !current||
        (
            !showY1&&
            !showAllOres
        )
    ){
        return;
    }

    const cx=
        snap(
            Math.floor(current.x)
        );

    const cz=
        snap(
            Math.floor(current.z)
        );

    const r=
        radius+
        MARGIN;

    const s=
        seed();

    const y=
        layerY();

    if(
        !force&&
        oresValid(
            cx,
            cz,
            r,
            s,
            y
        )
    ){
        return;
    }

    if(oreRun){

        oreQueued=true;
        return;
    }

    buildOres(
        cx,
        cz,
        r,
        s,
        y
    );
}


function scanY1(
    s,
    cx,
    cz,
    r,
    y
){

    const out=[];

    for(
        let x=cx-r;
        x<=cx+r;
        x++
    ){

        for(
            let z=cz-r;
            z<=cz+r;
            z++
        ){

            const id=
                getBlock(
                    s,
                    x,
                    y,
                    z
                );

            if(
                id!==null&&
                isAnyOre(id)
            ){

                out.push({
                    x,
                    y,
                    z,
                    id
                });
            }
        }
    }

    return out;
}


function scanAllOreChunk(
    ch,
    minX,
    maxX,
    minZ,
    maxZ,
    out
){

    for(
        let i=0;
        i<ch.data.length;
        i++
    ){

        const id=
            ch.data[i];

        if(
            !isAllOreTarget(id)
        ){
            continue;
        }

        const lx=
            Math.floor(
                i/
                1024
            );

        const rem=
            i-
            lx*1024;

        const ly=
            Math.floor(
                rem/
                32
            );

        const lz=
            rem-
            ly*32;

        const x=
            ch.cx*CS+
            lx;

        const y=
            ch.cy*CS+
            ly;

        const z=
            ch.cz*CS+
            lz;

        if(
            x<minX||
            x>maxX||
            z<minZ||
            z>maxZ
        ){
            continue;
        }

        out.push({
            x,
            y,
            z,
            id
        });
    }
}


async function buildOres(
    cx,
    cz,
    r,
    s,
    y
){

    const token=
        ++oreToken;

    oreRun=true;
    oreQueued=false;

    updateState();

    const minCX=
        floorDiv(
            cx-r,
            CS
        );

    const maxCX=
        floorDiv(
            cx+r,
            CS
        );

    const minCZ=
        floorDiv(
            cz-r,
            CS
        );

    const maxCZ=
        floorDiv(
            cz+r,
            CS
        );

    const jobs=[];

    if(showY1){

        const cy=
            floorDiv(
                y+1,
                CS
            );

        for(
            let x=minCX;
            x<=maxCX;
            x++
        ){

            for(
                let z=minCZ;
                z<=maxCZ;
                z++
            ){

                jobs.push({

                    s,

                    cx:
                        x,

                    cy,

                    cz:
                        z
                });
            }
        }
    }

    if(showAllOres){

        for(
            let x=minCX;
            x<=maxCX;
            x++
        ){

            for(
                let z=minCZ;
                z<=maxCZ;
                z++
            ){

                for(
                    const cy
                    of
                    ALL_ORE_LEVELS
                ){

                    jobs.push({

                        s,

                        cx:
                            x,

                        cy,

                        cz:
                            z
                    });
                }
            }
        }
    }

    const uniq=
        new Map();

    for(const j of jobs){

        uniq.set(
            `${j.cx}|${j.cy}|${j.cz}`,
            j
        );
    }

    try{

        await batches(
            [
                ...uniq.values()
            ],
            4,
            7
        );

        if(
            token!==
            oreToken
        ){
            return;
        }

        const y1=
            showY1

                ?scanY1(
                    s,
                    cx,
                    cz,
                    r,
                    y+1
                )

                :[];

        const all=[];

        if(showAllOres){

            const minX=
                cx-r;

            const maxX=
                cx+r;

            const minZ=
                cz-r;

            const maxZ=
                cz+r;

            let c=0;

            for(
                let x=minCX;
                x<=maxCX;
                x++
            ){

                for(
                    let z=minCZ;
                    z<=maxCZ;
                    z++
                ){

                    for(
                        const cy
                        of
                        ALL_ORE_LEVELS
                    ){

                        const ch=
                            chunks.get(
                                key(
                                    s,
                                    x,
                                    cy,
                                    z
                                )
                            );

                        if(ch){

                            scanAllOreChunk(
                                ch,
                                minX,
                                maxX,
                                minZ,
                                maxZ,
                                all
                            );
                        }

                        if(
                            ++c%3===
                            0
                        ){

                            await sleep(0);
                        }
                    }
                }
            }
        }

        if(
            token!==
            oreToken
        ){
            return;
        }

        y1OrePts=y1;
        allOrePts=all;

        oreCX=cx;
        oreCZ=cz;
        oreR=r;
        oreSeed=s;
        oreBaseY=y;

    }catch(e){

        if(
            e?.message!==
            "Seed changed"
        ){

            console.error(e);
        }

    }finally{

        if(
            token===
            oreToken
        ){

            oreRun=false;

            updateState();

            if(oreQueued){

                oreQueued=false;

                setTimeout(
                    ()=>
                        queueOres(true),
                    120
                );
            }
        }
    }
}


