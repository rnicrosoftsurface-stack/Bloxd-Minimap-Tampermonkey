    if(
        !force&&
        structuresValid(
            cx,
            cz,
            r,
            s
        )
    ){
        return;
    }

    if(structRun){

        structQueued=true;
        return;
    }

    buildStructures(
        cx,
        cz,
        r,
        s
    );
}


function scanStructureChunk(
    ch,
    minX,
    maxX,
    minZ,
    maxZ,
    out
){

    extractHighTierChests(
        ch,
        minX,
        maxX,
        minZ,
        maxZ,
        out
    );
}


async function buildStructures(
    cx,
    cz,
    r,
    s
){

    const token=
        ++structToken;

    structRun=true;
    structQueued=false;

    updateState();

    const minCX=
        floorDiv(
            cx-r,
            CS
        );

    const maxCX=
        floorDiv(
            cx+r,
            CS
        );

    const minCZ=
        floorDiv(
            cz-r,
            CS
        );

    const maxCZ=
        floorDiv(
            cz+r,
            CS
        );

    const jobs=[];

    // Alle relevanten Höhen laden.
    // Dadurch sieht man T4/T5-Chests auch,
    // wenn man gerade an der Oberfläche ist.
    for(
        let x=minCX;
        x<=maxCX;
        x++
    ){

        for(
            let z=minCZ;
            z<=maxCZ;
            z++
        ){

            for(
                let cy=STRUCT_MIN;
                cy<=STRUCT_MAX;
                cy++
            ){

                jobs.push({

                    s,

                    cx:
                        x,

                    cy,

                    cz:
                        z
                });
            }
        }
    }

    try{

        await batches(
            jobs,
            3,
            9
        );

        if(
            token!==
            structToken
        ){
            return;
        }

        const found=[];

        const minX=
            cx-r;

        const maxX=
            cx+r;

        const minZ=
            cz-r;

        const maxZ=
            cz+r;

        let c=0;

        for(
            let x=minCX;
            x<=maxCX;
            x++
        ){

            for(
                let z=minCZ;
                z<=maxCZ;
                z++
            ){

                for(
                    let cy=STRUCT_MIN;
                    cy<=STRUCT_MAX;
                    cy++
                ){

                    const ch=
                        chunks.get(
                            key(
                                s,
                                x,
                                cy,
                                z
                            )
                        );

                    if(ch){

                        scanStructureChunk(
                            ch,
                            minX,
                            maxX,
                            minZ,
                            maxZ,
                            found
                        );
                    }

                    if(
                        ++c%3===
                        0
                    ){

                        await sleep(0);
                    }
                }
            }
        }

        if(
            token!==
            structToken
        ){
            return;
        }

        // Keine doppelten Chest-Punkte
        const uniq=
            new Map();

        for(const p of found){

            const k=
                `${p.x}|${p.y}|${p.z}`;

            const old=
                uniq.get(k);

            if(
                !old||
                p.tier>
                old.tier
            ){

                uniq.set(
                    k,
                    p
                );
            }
        }

        structurePts=[
            ...uniq.values()
        ];

        structCX=cx;
        structCZ=cz;
        structR=r;
        structSeed=s;

    }catch(e){

        if(
            e?.message!==
            "Seed changed"
        ){

            console.error(e);
        }

    }finally{

        if(
            token===
            structToken
        ){

            structRun=false;

            updateState();

            if(structQueued){

                structQueued=false;

                setTimeout(
                    ()=>
                        queueStructures(true),
                    150
                );
            }
        }
    }
}


