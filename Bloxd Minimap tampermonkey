// ==========================================================
// T4 / T5 CHESTS
//
// Bloxd Generator:
// lootQuality 3 = EPIC      = T4
// lootQuality 4 = LEGENDARY = T5
// ==========================================================

function chestTierFromSpecialBlock(block){

    const raw=
        block?.data?.persisted?.lootQuality ??
        block?.data?.lootQuality ??
        block?.lootQuality;

    if(
        raw===undefined||
        raw===null
    ){
        return 0;
    }

    if(typeof raw==="string"){

        const u=
            raw
                .trim()
                .toUpperCase();

        if(
            u==="EPIC"||
            u==="T4"||
            u==="TIER 4"
        ){
            return 4;
        }

        if(
            u==="LEGENDARY"||
            u==="T5"||
            u==="TIER 5"
        ){
            return 5;
        }

        const n=
            Number(raw);

        if(Number.isFinite(n)){

            if(n===3)
                return 4;

            if(n===4)
                return 5;
        }

        return 0;
    }

    const q=
        Number(raw);

    if(q===3)
        return 4;

    if(q===4)
        return 5;

    return 0;
}


function extractHighTierChests(
    ch,
    minX,
    maxX,
    minZ,
    maxZ,
    out
){

    const special=
        ch?.metadata?.specialBlocks;

    if(!Array.isArray(special))
        return;

    for(const block of special){

        const persisted=
            block?.data?.persisted;

        const chestString=
            persisted?.chestStr;

        const pos=
            block?.pos;

        // Nur echte generierte Loot-Chests
        if(
            typeof chestString!=="string"||
            !Array.isArray(pos)||
            pos.length<3
        ){
            continue;
        }

        const tier=
            chestTierFromSpecialBlock(
                block
            );

        if(
            tier!==4&&
            tier!==5
        ){
            continue;
        }

        const x=
            Number(pos[0]);

        const y=
            Number(pos[1]);

        const z=
            Number(pos[2]);

        if(
            ![
                x,
                y,
                z
            ].every(Number.isFinite)
        ){
            continue;
        }

        if(
            x<minX||
            x>maxX||
            z<minZ||
            z>maxZ
        ){
            continue;
        }

        out.push({
            x,
            y,
            z,
            tier,
            lootQuality:
                persisted?.lootQuality
        });
    }
}


