// ==========================================================

function blockScreen(
    blockX,
    blockZ,
    ppb,
    cx,
    cy
){

    return{

        x:
            cx-
            (
                (
                    blockZ+
                    .5
                )
                -
                current.z
            )
            *
            ppb,

        y:
            cy-
            (
                (
                    blockX+
                    .5
                )
                -
                current.x
            )
            *
            ppb
    };
}


function worldScreen(
    worldX,
    worldZ,
    ppb,
    cx,
    cy
){

    return{

        x:
            cx-
            (
                worldZ-
                current.z
            )
            *
            ppb,

        y:
            cy-
            (
                worldX-
                current.x
            )
            *
            ppb
    };
}


// ==========================================================
// GRID
// ==========================================================

function grids(
    w,
    h,
    cx,
    cy,
    ppb
){

    if(!current)
        return;

    const minX=
        Math.floor(
            current.x-
            radius-
            2
        );

    const maxX=
        Math.ceil(
            current.x+
            radius+
            2
        );

    const minZ=
        Math.floor(
            current.z-
            radius-
            2
        );

    const maxZ=
        Math.ceil(
            current.z+
            radius+
            2
        );


    if(ppb>=2.2){

        ctx.strokeStyle=
            "rgba(0,0,0,.055)";

        ctx.lineWidth=
            1;

        for(
            let z=minZ;
            z<=maxZ+1;
            z++
        ){

            const sx=
                worldScreen(
                    0,
                    z,
                    ppb,
                    cx,
                    cy
                ).x;

            ctx.beginPath();

            ctx.moveTo(
                Math.round(sx)+.5,
                0
            );

            ctx.lineTo(
                Math.round(sx)+.5,
                h
            );

            ctx.stroke();
        }


        for(
            let x=minX;
            x<=maxX+1;
            x++
        ){

            const sy=
                worldScreen(
                    x,
                    0,
                    ppb,
                    cx,
                    cy
                ).y;

            ctx.beginPath();

            ctx.moveTo(
                0,
                Math.round(sy)+.5
            );

            ctx.lineTo(
                w,
                Math.round(sy)+.5
            );

            ctx.stroke();
        }
    }


    ctx.strokeStyle=
        "rgba(0,0,0,.22)";

    ctx.lineWidth=
        1.1;


    for(
        let z=
            Math.floor(
                minZ/
                32
            )
            *
            32;

        z<=maxZ;

        z+=32
    ){

        const sx=
            cx-
            (
                z-
                current.z
            )
            *
            ppb;

        ctx.beginPath();

        ctx.moveTo(
            sx+.5,
            0
        );

        ctx.lineTo(
            sx+.5,
            h
        );

        ctx.stroke();
    }


    for(
        let x=
            Math.floor(
                minX/
                32
            )
            *
            32;

        x<=maxX;

        x+=32
    ){

        const sy=
            cy-
            (
                x-
                current.x
            )
            *
            ppb;

        ctx.beginPath();

        ctx.moveTo(
            0,
            sy+.5
        );

        ctx.lineTo(
            w,
            sy+.5
        );

        ctx.stroke();
    }
}


// ==========================================================
// SURFACE SHADING
// ==========================================================

function surfaceShade(
    cell,
    up,
    down,
    left,
    right
){

    const h=
        cell.y??0;

    const uy=
        up?.y??h;

    const dy=
        down?.y??h;

    const ly=
        left?.y??h;

    const ry=
        right?.y??h;

    return clamp(

        (
            (
                ly+
                uy
            )
            -
            (
                ry+
                dy
            )
        )
        *
        2.4
        +
        noise(
            cell.x,
            cell.z,
            cell.id
        )
        *
        5,

        -28,

        20
    );
}


function drawRelief(
    sx,
    sy,
    ppb,
    cell,
    up,
    down,
    left,
    right
){

    if(ppb<2.4)
        return;

    const h=
        cell.y??0;

    const uy=
        up?.y??h;

    const dy=
        down?.y??h;

    const ly=
        left?.y??h;

    const ry=
        right?.y??h;

    const strip=
        Math.max(
            1,
            Math.floor(
                ppb*.14
            )
        );


    if(uy<h){

        ctx.fillStyle=
            `rgba(255,255,255,${clamp((h-uy)*.055,.035,.18)})`;

        ctx.fillRect(
            sx,
            sy,
            ppb,
            strip
        );
    }


    if(ly<h){

        ctx.fillStyle=
            `rgba(255,255,255,${clamp((h-ly)*.04,.025,.13)})`;

        ctx.fillRect(
            sx,
            sy,
            strip,
            ppb
        );
    }


    if(dy>h){

        ctx.fillStyle=
            `rgba(0,0,0,${clamp((dy-h)*.075,.05,.27)})`;

        ctx.fillRect(
            sx,
            sy+
            ppb-
            strip,
            ppb,
            strip
        );
    }


    if(ry>h){

        ctx.fillStyle=
            `rgba(0,0,0,${clamp((ry-h)*.075,.05,.27)})`;

        ctx.fillRect(
            sx+
            ppb-
            strip,
            sy,
            strip,
            ppb
        );
    }
}


function drawSurfaceDecoration(
    cell,
    sx,
    sy,
    ppb
){

    if(
        !cell.deco||
        ppb<3.5
    ){
        return;
    }

    const tex=
        surfaceTextureName(
            cell.deco
        );

    if(tex){

        drawAtlasTexture(
            tex,
            sx,
            sy,
            ppb,
            ppb
        );
    }
}


// ==========================================================
// MAP DRAW
// ==========================================================

function drawBase(
    w,
    h,
    cx,
    cy,
    ppb
){

    if(
        !mapData||
        !current
    ){
        return;
    }

    const size=
        mapData.length;

    for(
        let r=0;
        r<size;
        r++
    ){

        for(
            let c=0;
            c<size;
            c++
        ){

            const cell=
                mapData[r][c];

            if(
                !cell||
                isAir(cell.id)
            ){
                continue;
            }

            const p=
                blockScreen(
                    cell.x,
                    cell.z,
                    ppb,
                    cx,
                    cy
                );

            const sx=
                p.x-
                ppb/2;

            const sy=
                p.y-
                ppb/2;

            if(
                sx+ppb<0||
                sy+ppb<0||
                sx>w||
                sy>h
            ){
                continue;
            }


            if(mode==="surface"){

                const up=
                    mapData[
                        Math.max(
                            0,
                            r-1
                        )
                    ][c];

                const down=
                    mapData[
                        Math.min(
                            size-1,
                            r+1
                        )
                    ][c];

                const left=
                    mapData[r][
                        Math.max(
                            0,
                            c-1
                        )
                    ];

                const right=
                    mapData[r][
                        Math.min(
                            size-1,
                            c+1
                        )
                    ];


                const base=
                    blockColor(
                        cell.id
                    );

                ctx.fillStyle=
                    `rgb(${base[0]},${base[1]},${base[2]})`;

                ctx.fillRect(
                    sx,
                    sy,
                    ppb+.7,
                    ppb+.7
                );


                drawAtlasTexture(
                    surfaceTextureName(
                        cell.id
                    ),
                    sx,
                    sy,
                    ppb+.7,
                    ppb+.7
                );


                const sh=
                    surfaceShade(
                        cell,
                        up,
                        down,
                        left,
                        right
                    );


                if(sh<0){

                    ctx.fillStyle=
                        `rgba(0,0,0,${Math.min(.25,-sh/115)})`;

                    ctx.fillRect(
                        sx,
                        sy,
                        ppb+.7,
                        ppb+.7
                    );

                }else if(sh>0){

                    ctx.fillStyle=
                        `rgba(255,255,255,${Math.min(.12,sh/170)})`;

                    ctx.fillRect(
                        sx,
                        sy,
                        ppb+.7,
                        ppb+.7
                    );
                }


                drawRelief(
                    sx,
                    sy,
                    ppb,
                    cell,
                    up,
                    down,
                    left,
                    right
                );


                drawSurfaceDecoration(
                    cell,
                    sx,
                    sy,
                    ppb
                );

            }else{

                // Untergrund bleibt bewusst ohne Oberflächentexturen

                const col=
                    blockColor(
                        cell.id
                    );

                ctx.fillStyle=
                    `rgb(${col[0]},${col[1]},${col[2]})`;

                ctx.fillRect(
                    sx,
                    sy,
                    ppb+.7,
                    ppb+.7
                );
            }
        }
    }

    grids(
        w,
        h,
        cx,
        cy,
        ppb
    );
}


// ==========================================================
// ORE OVERLAY
// ==========================================================

function drawOreList(
    list,
    ppb,
    cx,
    cy,
    type,
    seen
){

    for(const p of list){

        const k=
            `${p.x}|${p.y}|${p.z}|${p.id}`;

        if(seen.has(k))
            continue;

        seen.add(k);


        const s=
            blockScreen(
                p.x,
                p.z,
                ppb,
                cx,
                cy
            );


        const col=
            oreColor(
                p.id
            );


        const size=
            Math.max(
                3,
                Math.min(
                    ppb*
                    (
                        type==="y1"
                            ?.72
                            :.58
                    ),
                    12
                )
            );


        ctx.save();

        ctx.globalAlpha=
            type==="y1"
                ?.96
                :.9;

        ctx.fillStyle=
            `rgb(${col[0]},${col[1]},${col[2]})`;

        ctx.fillRect(
            s.x-
            size/2,

            s.y-
            size/2,

            size,

            size
        );

        ctx.strokeStyle=
            type==="y1"
                ?"rgba(255,255,255,.95)"
                :"rgba(0,0,0,.75)";

        ctx.lineWidth=
            1;

        ctx.strokeRect(
            s.x-
            size/2+
            .5,

            s.y-
            size/2+
            .5,

            size-
            1,

            size-
            1
        );

        ctx.restore();
    }
}


// ==========================================================
// T4 / T5 CHEST MARKERS
// ==========================================================

function drawStructures(
    ppb,
    cx,
    cy
){

    if(!showSpawner)
        return;

    for(const p of structurePts){

        const s=
            blockScreen(
                p.x,
                p.z,
                ppb,
                cx,
                cy
            );


        const size=
            clamp(
                ppb*
                1.7,
                8,
                16
            );


        const isT5=
            p.tier===5;


        const color=
            isT5
                ?"#bd55ff"
                :"#ffd238";


        const fill=
            isT5
                ?"rgba(189,85,255,.24)"
                :"rgba(255,210,56,.24)";


        ctx.save();


        ctx.shadowColor=
            isT5
                ?"rgba(189,85,255,.8)"
                :"rgba(255,210,56,.8)";


        ctx.shadowBlur=
            7;


        ctx.fillStyle=
            fill;


        ctx.fillRect(
            s.x-
            size/2,

            s.y-
            size/2,

            size,

            size
        );


        ctx.strokeStyle=
            color;


        ctx.lineWidth=
            2;


        ctx.strokeRect(
            s.x-
            size/2+
            .5,

            s.y-
            size/2+
            .5,

            size-
            1,

            size-
            1
        );


        ctx.shadowBlur=
            0;


        // T4 / T5 Nummer
        if(size>=11){

            ctx.fillStyle=
                color;

            ctx.font=
                "900 8px Arial";

            ctx.textAlign=
                "center";

            ctx.textBaseline=
                "middle";

            ctx.fillText(
                String(p.tier),
                s.x,
                s.y+.5
            );
        }


        ctx.restore();
    }
}


// ==========================================================
// PLAYER
// ==========================================================

function drawPlayer(
    cx,
    cy
){

    ctx.save();

    ctx.shadowColor=
        "#6eeaff";

    ctx.shadowBlur=
        10;

    ctx.fillStyle=
        "#6eeaff";

    ctx.beginPath();

    ctx.arc(
        cx,
        cy,
        5,
        0,
        Math.PI*2
    );

    ctx.fill();

    ctx.shadowBlur=
        0;

    ctx.strokeStyle=
        "white";

    ctx.lineWidth=
        1.5;

    ctx.stroke();

    ctx.restore();
}


// ==========================================================
// SCALE
// ==========================================================

function drawScale(
    ppb,
    h
){

    const blocks=
        radius<=3
            ?1
            :radius<=5
                ?2
                :10;


    const len=
        Math.min(
            blocks*
            ppb,
            MAP_W-
            28
        );


    const x=
        12;

    const y=
        h-
        18;


    ctx.strokeStyle=
        "white";

    ctx.lineWidth=
        2;


    ctx.beginPath();

    ctx.moveTo(
        x,
        y
    );

    ctx.lineTo(
        x+len,
        y
    );

    ctx.stroke();


    ctx.beginPath();

    ctx.moveTo(
        x,
        y-4
    );

    ctx.lineTo(
        x,
        y+4
    );


    ctx.moveTo(
        x+len,
        y-4
    );

    ctx.lineTo(
        x+len,
        y+4
    );

    ctx.stroke();


    ctx.fillStyle=
        "white";

    ctx.font=
        "9px Consolas";

    ctx.fillText(
        `${blocks} block${blocks===1?"":"s"}`,
        x,
        y-6
    );
}


// ==========================================================
// MODE LABEL
// ==========================================================

function drawModeLabel(w){

    const label=
        mode==="surface"
            ?"MAP"
            :`Y ${layerY()}`;

    ctx.font=
        "800 10px Consolas";

    const tw=
        ctx.measureText(
            label
        ).width+
        12;

    ctx.fillStyle=
        "rgba(4,12,19,.72)";

    ctx.fillRect(
        w-
        tw-
        8,
        8,
        tw,
        20
    );

    ctx.fillStyle=
        "#dff7ff";

    ctx.fillText(
        label,
        w-
        tw-
        2,
        22
    );
}


// ==========================================================
// DRAW
// ==========================================================

function draw(){

    if(
        !ctx||
        !canvas
    ){
        return;
    }

    const w=
        canvas.width;

    const h=
        canvas.height;

    const cx=
        w/2;

    const cy=
        h/2;

    const ppb=
        w/
        (
            radius*
            2
        );


    ctx.imageSmoothingEnabled=
        false;


    ctx.fillStyle=
        "#07111a";

    ctx.fillRect(
        0,
        0,
        w,
        h
    );


    drawBase(
        w,
        h,
        cx,
        cy,
        ppb
    );


    const seen=
        new Set();


    if(showAllOres){

        drawOreList(
            allOrePts,
            ppb,
            cx,
            cy,
            "all",
            seen
        );
    }


    if(showY1){

        drawOreList(
            y1OrePts,
            ppb,
            cx,
            cy,
            "y1",
            seen
        );
    }


    drawStructures(
        ppb,
        cx,
        cy
    );


    drawPlayer(
        cx,
        cy
    );


    drawScale(
        ppb,
        h
    );


    drawModeLabel(
        w
    );
}


function loop(now){

    if(
        now-
        lastDraw>=
        DRAW_MS
    ){

        lastDraw=
            now;

        updateText();
        updateState();
        draw();
    }

    requestAnimationFrame(
        loop
    );
}


// ==========================================================
// START
// ==========================================================

hook();


function boot(){

    ui();

    init();

    requestAnimationFrame(
        loop
    );
}


if(
    document.readyState===
    "loading"
){

    document.addEventListener(
        "DOMContentLoaded",
        boot,
        {
            once:true
        }
    );

}else{

    boot();
}


