function nextIn(){

    const a=
        ZOOMS.filter(
            v=>
                v<radius
        );

    return a.length
        ?a[a.length-1]
        :radius;
}


function nextOut(){

    const a=
        ZOOMS.filter(
            v=>
                v>radius
        );

    return a.length
        ?a[0]
        :radius;
}


function setRadius(r){

    if(r===radius)
        return;

    radius=r;

    radiusEl.textContent=
        `R ${radius}`;

    invalidateMap();
    invalidateOres();
    invalidateStructures();

    queueMap(true);

    if(
        showY1||
        showAllOres
