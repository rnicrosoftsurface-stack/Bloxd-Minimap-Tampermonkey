        );

    if(!e)
        return fallbackTextureName(id);

    const ti=
        e.textureInfo;

    let candidates=[];

    if(typeof ti==="string"){

        candidates=[
            ti
        ];

    }else if(Array.isArray(ti)){

        candidates=
            ti.filter(
                v=>
                    typeof v==="string"
            );
    }

    if(typeof e.itemTexture==="string"){

        candidates.push(
            e.itemTexture
        );
    }

    candidates=
        candidates
            .map(
                normalTexName
            )
            .filter(Boolean);

    const top=
        candidates.find(
            n=>
                /(^|_)top($|_)/.test(n)||
                n==="grass_top"
        )
        ||
        candidates[0];

    if(
        top&&
        SURFACE_TEX_INDEX[top]!==undefined
    ){
        return top;
    }

    for(const n of candidates){

        if(
            SURFACE_TEX_INDEX[n]!==undefined
        ){
            return n;
        }
    }

    return fallbackTextureName(id);
}


function fallbackTextureName(id){

    const t=
        text(id);

    const n=
        nameOf(id)
            .toLowerCase();

    let m;

    if(t.includes("jungle grass block"))
        return"jungle_grass_block";

    if(t.includes("pine grass block"))
        return"pine_grass_block";

    if(t.includes("grass block"))
        return"grass_top";

    if(t.includes("red sand"))
        return"red_sand";

    if(t.includes("sand"))
        return"sand";

    if(t.includes("rocky dirt"))
        return"rocky_dirt";

    if(t.includes("messy dirt"))
        return"coarse_dirt";

    if(t.includes("dirt"))
        return"dirt";

    if(t.includes("gravel"))
        return"gravel";

    if(t.includes("packed snow"))
        return"packed_snow";

    if(t.includes("snow"))
        return"snow";

    if(t.includes("clay"))
        return"clay";

    if(t.includes("smooth stone"))
        return"smooth_stone";

    if(t.includes("messy stone"))
        return"messy_stone";

    if(t.includes("andesite"))
        return"stone_andesite";

    if(t.includes("diorite"))
        return"stone_diorite";

    if(t.includes("granite"))
        return"stone_granite";

    if(t.includes("stone"))
        return"stone";

    if(
        (
            m=n.match(
                /(aspen|cedar|cherry|elm|jungle|mango|maple|palm|pear|pine|plum|spectral).*leav/
            )
        )
    ){
        return`leaves_${m[1]}`;
    }

    if(
        (
            m=n.match(
                /(aspen|cedar|cherry|elm|jungle|mango|maple|palm|pear|pine|plum|spectral).*log/
            )
        )
    ){
        return`log_${m[1]}`;
    }

    if(t.includes("poppy"))
        return"poppy";

    if(
        t.includes("oxeye daisy")||
        t.includes("daisy")
    ){
        return"oxeye_daisy";
    }

    if(
        t.includes("lily of the valley")
    ){
        return"lily_of_the_valley";
    }

    if(
        t.includes("jungle tall grass")
    ){
        return"jungle_tall_grass_bottom";
    }

    if(
        t.includes("tall grass")||
        t.includes("grass plant")
    ){
        return"tallgrass";
    }

    return null;
}


function drawAtlasTexture(
    texName,
    dx,
    dy,
    dw,
    dh
){

    if(
        !surfaceAtlasReady||
        !texName
    ){
        return false;
    }

    const i=
        SURFACE_TEX_INDEX[
            texName
        ];

    if(i===undefined)
        return false;

    const sx=
        (
            i%
            SURFACE_ATLAS_COLS
        )
        *
        SURFACE_ATLAS_CELL;

    const sy=
        Math.floor(
            i/
            SURFACE_ATLAS_COLS
        )
        *
        SURFACE_ATLAS_CELL;

    ctx.drawImage(
        surfaceAtlas,
        sx,
        sy,
        SURFACE_ATLAS_CELL,
        SURFACE_ATLAS_CELL,
        dx,
        dy,
        dw,
        dh
    );

    return true;
}


