function statsKey(
    s,
    cx,
    cy,
    cz
){

    return`${s}|${cx}|${cy}|${cz}`;
}


function countChunk(ch){

    const byId=
        new Map();

    let air=0;

    for(
        let i=0;
        i<ch.data.length;
        i++
    ){

        const id=
            Number(
                ch.data[i]
            );

        byId.set(
            id,
            (
                byId.get(id)||
                0
            )+
            1
        );

        if(isAir(id))
            air++;
    }

    const rows=
        [
            ...byId.entries()
        ]
        .map(
            (
                [
                    id,
                    count
                ]
            )=>({

                id,

                name:
                    nameOf(id),

                count
            })
        )
        .sort(
            (
                a,
                b
            )=>

                b.count-
                a.count
                ||
                a.name.localeCompare(
                    b.name
                )
        );

    return{

        rows,

        air,

        solid:
            32768-
            air,

        total:
            32768
    };
}


