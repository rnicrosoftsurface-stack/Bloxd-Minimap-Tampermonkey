function updateState(
    force=null
){

    if(
        !stateEl||
        !seedEl
    ){
        return;
    }

    seedEl.textContent=
        `SEED ${seed()}`;

    if(force){

        stateEl.textContent=
            force;

        stateEl.style.color=
            "#ffd166";

        return;
    }

    if(error){

        stateEl.textContent=
            "MAP ERROR";

        stateEl.style.color=
            "#ff6b73";

        return;
    }

    if(!ready){

        stateEl.textContent=
            "ENGINE LOAD";

        stateEl.style.color=
            "#ffd166";

        return;
    }

    if(
        buildRun||
        oreRun||
        structRun
    ){

        stateEl.textContent=
            structRun
                ?"CHESTS SCAN"
                :oreRun
                    ?"ORES LOADING"
                    :mode==="surface"
                        ?"MAP LOADING"
                        :`Y ${layerY()} LOADING`;

        stateEl.style.color=
            "#ffd166";

        return;
    }

    stateEl.textContent=
        mapData
            ?mode==="surface"
                ?"MAP READY"
                :`Y ${mapYBuilt} READY`
            :"MAP WAIT";

    stateEl.style.color=
        mapData
            ?"#52ff93"
            :"#8fa2b7";
}


