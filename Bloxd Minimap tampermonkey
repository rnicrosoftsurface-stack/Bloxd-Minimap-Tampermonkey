async function queueChunkStats(
    force=false
){

    if(
        !ready||
        !current||
        !chunkDetails?.open
    ){
        return;
    }

    const s=
        seed();

    const cx=
        floorDiv(
            Math.floor(current.x),
            CS
        );

    const cy=
        floorDiv(
            Math.floor(current.y),
            CS
        );

    const cz=
        floorDiv(
            Math.floor(current.z),
            CS
        );

    const k=
        statsKey(
            s,
            cx,
            cy,
            cz
        );

    if(
        !force&&
        lastChunkStatsKey===k&&
        chunkStatsCache.has(k)
    ){
        return;
    }

    lastChunkStatsKey=k;

    const token=
        ++chunkStatsToken;

    chunkSummaryEl.textContent=
        ` Chunk ${cx}, ${cy}, ${cz} • lade…`;

    chunkListEl.textContent="";

    try{

        let stats=
            chunkStatsCache.get(k);

        if(!stats){

            const ch=
                await chunk(
                    s,
                    cx,
                    cy,
                    cz
                );

            if(
                token!==
                chunkStatsToken
            ){
                return;
            }

            stats=
                countChunk(ch);

            chunkStatsCache.set(
                k,
                stats
            );

            while(
                chunkStatsCache.size>
                24
            ){

                chunkStatsCache.delete(
                    chunkStatsCache
                        .keys()
                        .next()
                        .value
                );
            }
        }

        if(
            token!==
            chunkStatsToken
        ){
            return;
        }

        renderChunkStats(
            stats,
            cx,
            cy,
            cz
        );

    }catch(_){

        if(
            token===
            chunkStatsToken
        ){

            chunkSummaryEl.textContent=
                " Chunk-Liste konnte nicht geladen werden";
        }
    }
}


